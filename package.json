{
  "name": "patina-cli",
  "version": "9.1.0",
  "description": "AI text humanizer CLI — detects and removes AI writing patterns",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "patina": "bin/patina.js",
    "patina-cli": "bin/patina.js",
    "patina-score": "scripts/precommit-score.mjs"
  },
  "scripts": {
    "test": "node -r ./tests/helpers/real-tmpdir.cjs --test tests/unit/*.test.js tests/e2e/*.test.js",
    "test:unit": "node -r ./tests/helpers/real-tmpdir.cjs --test tests/unit/*.test.js",
    "launch-config:generate": "node scripts/generate-launch-config.mjs",
    "test:e2e": "node -r ./tests/helpers/real-tmpdir.cjs --test tests/e2e/*.test.js",
    "test:browser": "node -r ./tests/helpers/real-tmpdir.cjs --test tests/browser/*.test.js",
    "smoke:platform": "node scripts/platform-smoke.mjs",
    "benchmark": "node tests/quality/benchmark.mjs",
    "benchmark:perf": "node scripts/perf-report.mjs",
    "benchmark:rebaseline:low-fpr": "node scripts/rebaseline-low-fpr-report.mjs",
    "benchmark:robustness": "node scripts/robustness-report.mjs",
    "benchmark:report": "node scripts/benchmark-report.mjs",
    "benchmark:rebaseline": "node scripts/rebaseline-summary.mjs",
    "benchmark:rebaseline:report": "node scripts/rebaseline-summary.mjs --write",
    "benchmark:register-pilot": "node scripts/rebaseline-summary.mjs --input artifacts/rebaseline-2025/human-controls.public.jsonl",
    "benchmark:persona-calibration": "node scripts/persona-calibration.mjs",
    "benchmark:ai-tells-baseline": "node scripts/ai-tells-corpus-baseline.mjs",
    "benchmark:detector-candidates": "node scripts/detector-candidate-eval.mjs",
    "benchmark:cadence-fixture": "node scripts/cadence-fixture-eval.mjs",
    "benchmark:ko-conjunction": "node scripts/ko-conjunction-candidate-eval.mjs",
    "benchmark:ko-comma-excess": "node scripts/ko-comma-excess-candidate-eval.mjs",
    "benchmark:ko-agent-tone": "node scripts/ko-agent-tone-candidate-eval.mjs",
    "benchmark:ko-residual-translationese": "node scripts/ko-residual-translationese-candidate-eval.mjs",
    "quality:adversarial-mps": "node scripts/adversarial-mps-report.mjs --check",
    "quality:persona-ablation": "node scripts/persona-ablation.mjs",
    "dogfood": "node tests/quality/dogfood.mjs",
    "card": "node scripts/share-card.mjs",
    "lint": "npm run lint:syntax && npm run lint:eslint && npm run typecheck && npm run spellcheck && npm run check:architecture",
    "release:check": "node scripts/check-release-metadata.mjs && node scripts/check-retired-concepts.mjs",
    "release:sync-plugin-versions": "node scripts/check-release-metadata.mjs --sync-plugin-versions",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:no-private-assets": "node scripts/check-no-private-assets.mjs",
    "prepublishOnly": "npm run release:check && npm run check:no-private-assets && npm run lint && npm test && npm run benchmark:report && npm run dogfood",
    "benchmark:ranges": "node scripts/update-benchmark-ranges.mjs",
    "benchmark:compare": "node scripts/detector-comparison.mjs",
    "lint:syntax": "node scripts/lint.mjs",
    "lint:eslint": "eslint .",
    "typecheck": "tsc -p .",
    "spellcheck": "cspell \"patterns/**/*.md\" \"lexicon/**/*.md\" --gitignore-root .",
    "quality:live": "node tests/quality/live-quality.mjs",
    "benchmark:scorer:live": "node tests/quality/live-scorer-benchmark.mjs",
    "quality:model-rewrite": "node scripts/research/model-rewrite-benchmark.mjs",
    "benchmark:rebaseline:intake": "node scripts/rebaseline-intake.mjs",
    "benchmark:rebaseline:score": "node scripts/rebaseline-score.mjs",
    "benchmark:signal-impact": "node scripts/signal-impact.mjs",
    "benchmark:rebaseline:web": "node scripts/rebaseline-web-collect.mjs",
    "lexicon:freshness": "node scripts/lexicon-freshness.mjs --check",
    "benchmark:rebaseline:generate-modern": "node scripts/rebaseline-generate-modern.mjs",
    "benchmark:rebaseline:claim-manifest": "node scripts/rebaseline-build-claim-manifest.mjs",
    "benchmark:rebaseline:fp-fixtures": "node scripts/fp-fixture-export.mjs",
    "benchmark:ko-miss-review:extract": "node scripts/ko-miss-review-extract.mjs",
    "benchmark:ko-miss-review:validate": "node scripts/ko-miss-review-validate.mjs",
    "benchmark:ko-miss-review:report": "node scripts/ko-miss-review-report.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=18.1.0"
  },
  "keywords": [
    "ai",
    "ai-writing",
    "humanizer",
    "ai-humanizer",
    "llm-humanizer",
    "text-humanizer",
    "writing",
    "writing-tools",
    "stylometry",
    "korean",
    "korean-nlp",
    "chinese",
    "japanese",
    "nlp",
    "claude-code",
    "codex-cli",
    "claude",
    "cursor",
    "opencode",
    "nodejs-cli"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devswha/patina.git"
  },
  "homepage": "https://github.com/devswha/patina#readme",
  "bugs": {
    "url": "https://github.com/devswha/patina/issues"
  },
  "files": [
    "bin/",
    "src/",
    "core/",
    "patterns/",
    "document-types/",
    "lexicon/",
    "personas/",
    "docs/",
    "!docs/internal/**",
    "!docs/operations/**",
    "!docs/research/**",
    "!docs/benchmarks/*.json",
    "assets/brand/",
    "assets/social/",
    "assets/demo/README.md",
    "README.md",
    "README_KR.md",
    "README_ZH.md",
    "README_JA.md",
    "SKILL.md",
    ".patina.default.yaml",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "scripts/precommit-score.mjs",
    "scripts/prose-score.mjs",
    "!AGENTS.md",
    "!**/AGENTS.md",
    "!CLAUDE.md",
    "!**/CLAUDE.md",
    "!BOOTSTRAP.md",
    "!**/BOOTSTRAP.md",
    "!IDENTITY.md",
    "!**/IDENTITY.md",
    "!USER.md",
    "!**/USER.md",
    "!MEMORY.md",
    "!**/MEMORY.md",
    "!HEARTBEAT.md",
    "!**/HEARTBEAT.md",
    "!SOUL.md",
    "!**/SOUL.md",
    "!TOOLS.md",
    "!**/TOOLS.md",
    "!memory/**",
    "!**/memory/**",
    "!.omc/**",
    "!**/.omc/**",
    "!.omx/**",
    "!**/.omx/**",
    "!.omo/**",
    "!**/.omo/**",
    "!.openclaw/**",
    "!**/.openclaw/**",
    "!.workclaw/**",
    "!**/.workclaw/**",
    "!.claude/**",
    "!**/.claude/**",
    "!.insane-review/**",
    "!**/.insane-review/**",
    "!.gjc/**",
    "!**/.gjc/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.130",
    "cspell": "^8.19.4",
    "eslint": "^10.10.0",
    "espree": "9.6.1",
    "playwright": "1.63.0",
    "semver": "7.8.5",
    "typescript": "^7.0.2"
  }
}
